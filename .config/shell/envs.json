{
  "BAT_CONFIG_DIR": "$DOTFILES_CONFIG_DIR/bat",
  "CLICOLOR": "1",
  "COREPACK_ENABLE_STRICT": "0",
  "DOCKER_VOLUMES": "/media/sdb/Documents/docker-volumes",
  "EDITOR": "vim",
  "EXTERNAL_DISK": "/media/sdb",
  "GCC_COLORS": "'error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'",
  "GIT_OPTIONAL_LOCKS": "0",
  "HISTCONTROL": "ignoreboth",
  "HISTSIZE": "50000",
  "HOMEBREW_NO_ASK": "1",
  "HOMEBREW_NO_AUTO_UPDATE": "1",
  "LANG": "en_US.UTF-8",
  "LANGUAGE": "en_US.UTF-8",
  "LC_ALL": "en_US.UTF-8",
  "LESS": "-RS#3NM~g",
  "LG_CONFIG_FILE": "$DOTFILES_CONFIG_DIR/lazygit/config.yml",
  "MAGIC_ENTER_COMMAND": "peek",
  "MISE_AUTO_ENV": "true",
  "MISE_YES": "true",
  "NODE_USE_ENV_PROXY": "1",
  "OPENCODE_DISABLE_CLAUDE_CODE": "1",
  "PERSONAL_PROJECTS_DIR": "$XDG_PROJECTS_DIR/personal",
  "PI_CODING_AGENT_DIR": "$DOTFILES_CONFIG_DIR/pi/agent",
  "PI_CODING_AGENT_SESSION_DIR": "$XDG_DATA_HOME/pi/sessions",
  "PI_OFFLINE": "1",
  "PI_SKIP_VERSION_CHECK": "true",
  "PI_TELEMETRY": "false",
  "POWERSHELL_TELEMETRY_OPTOUT": "1",
  "POWERSHELL_UPDATECHECK": "Off",
  "SAVEHIST": "10000",
  "SSH_KEY_PATH": "$HOME/.ssh/id_rsa",
  "STARSHIP_CONFIG": "$DOTFILES_CONFIG_DIR/starship/config.toml",
  "STARSHIP_LOG": "error",
  "VIMINIT": "source $DOTFILES_CONFIG_DIR/vim/config.vim",
  "XDG_DESKTOP_DIR": "$HOME/Desktop",
  "XDG_DOCUMENTS_DIR": "$HOME/Documents",
  "XDG_DOWNLOAD_DIR": "$HOME/Downloads",
  "XDG_MUSIC_DIR": "$HOME/Music",
  "XDG_PICTURES_DIR": "$HOME/Pictures",
  "XDG_PROJECTS_DIR": "$HOME/Projects",
  "XDG_PUBLICSHARE_DIR": "$HOME/Public",
  "XDG_TEMPLATES_DIR": "$HOME/Templates",
  "XDG_VIDEOS_DIR": "$HOME/Videos",
  "ZEROBREW_BIN": "$HOME/.zerobrew/bin",
  "ZEROBREW_DIR": "$HOME/.zerobrew",
  "ZEROBREW_PREFIX": "$XDG_DATA_HOME/zerobrew",
  "ZEROBREW_ROOT": "$XDG_DATA_HOME/zerobrew",
  "ZSH_AUTO_PEEK_ENABLED": "true",
  "ZSH_COMPDUMP": "$XDG_CACHE_HOME/zsh/.zcompdump-$HOST-$ZSH_VERSION",
  "ZSH_TMUX_AUTONAME_SESSION": "true",
  "__PSLockDownPolicy": "0"
}
