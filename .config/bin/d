#!/usr/bin/env bash
set -euo pipefail

if [[ -f package.json ]]; then
  script=$(jq -r '.scripts // {} | if has("dev:stage") then "dev:stage" elif has("dev") then "dev" else empty end' package.json)
  if [[ $script == dev:stage ]]; then
    $DOTFILES_CONFIG_DIR/bin/nr dev:stage
  elif [[ $script == dev ]]; then
    $DOTFILES_CONFIG_DIR/bin/nr dev
  else
    echo 'No dev script found in package.json'
  fi
else
  echo 'No package.json found'
fi
