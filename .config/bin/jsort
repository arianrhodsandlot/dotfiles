#!/usr/bin/env bash
set -euo pipefail

for file in "$@"; do
  if [[ "$file" == *.json ]]; then
    jq -S . "$file" >"$file.tmp" && mv "$file.tmp" "$file"
  fi
done

if type vp &>/dev/null; then
  if [[ "$PWD" == "$HOME" ]]; then
    echo '{ "private": true }' >"$HOME/package.json"
  fi
  vp fmt "$@"
  rm -f "$HOME/package.json"
fi
